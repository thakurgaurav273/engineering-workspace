{
  "name": "grovyn-one",
  "private": true,
  "version": "1.0.0",
  "description": "Grovyn One - application platform monorepo (web + api + shared packages + services)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run web:dev\" \"npm run api:dev\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "web:dev": "npm run dev --workspace @grovyn/web",
    "web:build": "npm run build --workspace @grovyn/web",
    "web:start": "npm run start --workspace @grovyn/web",
    "web:lint": "npm run lint --workspace @grovyn/web",
    "web:typecheck": "npm run typecheck --workspace @grovyn/web",
    "api:dev": "npm run start:dev --workspace @grovyn/api",
    "api:build": "npm run build --workspace @grovyn/api",
    "api:start": "npm run start --workspace @grovyn/api",
    "api:test": "npm run test --workspace @grovyn/api",
    "api:db:generate": "npm run db:generate --workspace @grovyn/api",
    "api:db:migrate": "npm run db:migrate --workspace @grovyn/api",
    "api:db:studio": "npm run db:studio --workspace @grovyn/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "prettier": "^3.7.3"
  },
  "overrides": {
    "rxjs": "7.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
