# apps/web (Next.js) - client env. Only NEXT_PUBLIC_* is exposed to the browser and is
# inlined at build time. Copy to apps/web/.env.local for local dev.
# (Migrated from the old Vite VITE_* names.)

NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Feature flags (off by default)
NEXT_PUBLIC_FLAG_REGISTRY_NAV=true
NEXT_PUBLIC_FLAG_PLATFORM_SHELL=true
