# apps/web (Next.js) - client env. Only NEXT_PUBLIC_* is exposed to the browser and is
# inlined at build time. Copy to apps/web/.env.local for local dev.
# (Migrated from the old Vite VITE_* names.)

NEXT_PUBLIC_API_URL=

# Platform branding (product name/tagline/logo) - shown on sign-in and wherever no
# organization is in scope; inside the app each organization's own name and logo
# (Settings -> Organization) take over. Logo: absolute URL or a path under apps/web/public.
# Empty name = "Workspace"; empty logo = a monogram of the name.
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_TAGLINE=
NEXT_PUBLIC_APP_LOGO_URL=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Feature flags (off by default)
NEXT_PUBLIC_FLAG_REGISTRY_NAV=true
NEXT_PUBLIC_FLAG_PLATFORM_SHELL=true
