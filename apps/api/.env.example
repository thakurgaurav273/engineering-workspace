DATABASE_URL="postgresql://postgres:password@localhost:5432/grovyn_one"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
RESEND_API_KEY=""
MAIL_FROM="Grovyn One <onboarding@resend.dev>"
ENCRYPTION_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Cloudflare R2 (avatars + future file uploads)
# Uploads go straight from the browser to R2 via presigned URLs generated by the API.
# The R2 bucket must have a CORS policy allowing PUT from your frontend origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL the bucket is served from (R2 public dev URL or a custom domain), no trailing slash
R2_PUBLIC_URL=
# AI invoice drafting (Business Operations). Hugging Face router (OpenAI-compatible).
# Optional — the "AI draft" feature is hidden while HF_API_KEY is empty.
# Get a key at https://huggingface.co/settings/tokens and enable an inference provider.
HF_API_KEY=
# Model id; a provider suffix (":featherless-ai") is appended automatically if omitted.
HF_MODEL="mistralai/Mistral-7B-Instruct-v0.2"
