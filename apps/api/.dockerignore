# The api image builds with `context: ./apps/api`, so the root .dockerignore does
# not apply here — this file is what guards that context.
#
# `COPY . .` runs after `npm install`. Without these excludes a macOS-built
# node_modules would overwrite the container's Linux one (breaking Prisma's
# native query engine), and .env would bake real credentials into the image.
node_modules
dist

.env
.env.*
!.env.example

*.log
.DS_Store
