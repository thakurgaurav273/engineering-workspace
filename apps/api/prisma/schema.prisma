generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String                     @unique
  status                    OrgStatus                  @default(ACTIVE)
  logoUrl                   String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  linearApiKey              String?
  linearConnectedAt         DateTime?
  linearWorkspaceName       String?
  description               String?
  applicationConfigurations ApplicationConfiguration[]
  applicationInstallations  ApplicationInstallation[]
  userApplicationAccess     UserApplicationAccess[]
  checkIns                  CheckIn[]
  clients                   Client[]
  companyProfile            CompanyProfile?
  documentNumberSequences   DocumentNumberSequence[]
  goals                     Goal[]
  invitations               Invitation[]
  invoices                  Invoice[]
  linearIssues              LinearIssue[]
  memberships               Membership[]
  notifications             Notification[]
  offerLetters              OfferLetter[]
  offerLetterTemplates      OfferLetterTemplate[]
  settings                  OrganizationSettings?
  payments                  Payment[]
  proposals                 Proposal[]
  pushDevices               PushDevice[]
  quotations                Quotation[]
  recognitions              Recognition[]
  taskUpdates               TaskUpdate[]
  taxConfig                 TaxConfig?
  users                     User[]
  reviews                   WeeklyReview[]
  workspaceItems            WorkspaceItem[]
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  passwordHash             String
  firstName                String
  lastName                 String
  avatarUrl                String?
  orgId                    String
  managerId                String?
  department               String?
  jobTitle                 String?
  isActive                 Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  role                     Role                     @default(MEMBER)
  defaultOrganizationId    String?
  lastActiveOrganizationId String?
  signatureUrl             String?
  checkIns                 CheckIn[]                @relation("CheckInAuthor")
  goalsAssigned            Goal[]                   @relation("GoalAssignedBy")
  goals                    Goal[]                   @relation("GoalOwner")
  invitationsSent          Invitation[]             @relation("InvitedBy")
  linearIssueAssignments   LinearIssue[]            @relation("LinearIssueAssignee")
  memberships              Membership[]
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  switchLogs               OrganizationSwitchLog[]
  platformRoleAssignments  PlatformRoleAssignment[]
  pushDevices              PushDevice[]
  recognitionsGiven        Recognition[]            @relation("RecognitionAuthor")
  recognitionsReceived     Recognition[]            @relation("RecognitionRecipient")
  sessions                 Session[]
  taskUpdatesAuthored      TaskUpdate[]             @relation("TaskUpdateAuthor")
  manager                  User?                    @relation("UserManager", fields: [managerId], references: [id])
  reports                  User[]                   @relation("UserManager")
  org                      Organization             @relation(fields: [orgId], references: [id])
  preference               UserPreference?
  userRoleAssignments      UserRoleAssignment[]
  applicationAccess        UserApplicationAccess[]
  reviewsAsReviewee        WeeklyReview[]           @relation("RevieweeUser")
  reviewsAsReviewer        WeeklyReview[]           @relation("ReviewerUser")
  workspaceItemsAssigned   WorkspaceItem[]          @relation("WorkspaceItemAssignedBy")
  workspaceItemsOwned      WorkspaceItem[]          @relation("WorkspaceItemOwner")
  workspaceComments        WorkspaceItemComment[]   @relation("WorkspaceCommentAuthor")

  @@index([orgId])
  @@index([managerId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  id                    String           @id @default(cuid())
  userId                String
  orgId                 String
  role                  Role             @default(MEMBER)
  status                MembershipStatus @default(ACTIVE)
  managerId             String?
  department            String?
  jobTitle              String?
  joinedAt              DateTime?
  invitedByMembershipId String?
  lastSeenAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  invitedBy             Membership?      @relation("MembershipInviter", fields: [invitedByMembershipId], references: [id])
  invitees              Membership[]     @relation("MembershipInviter")
  manager               Membership?      @relation("MembershipManager", fields: [managerId], references: [id])
  reports               Membership[]     @relation("MembershipManager")
  org                   Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([managerId])
}

model OrganizationSwitchLog {
  id        String   @id @default(cuid())
  userId    String
  fromOrgId String?
  toOrgId   String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OrganizationSettings {
  id                 String       @id @default(cuid())
  orgId              String       @unique
  defaultRole        Role         @default(MEMBER)
  allowGuestAccess   Boolean      @default(false)
  invitationPolicy   String       @default("admin_only")
  onboardingDefaults Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          String           @id @default(cuid())
  orgId       String
  email       String
  token       String           @unique
  role        Role             @default(MEMBER)
  status      InvitationStatus @default(pending)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email, status])
  @@index([orgId])
  @@index([token])
}

model UserPreference {
  userId                  String  @id
  timezone                String  @default("UTC")
  emailNotifications      Boolean @default(true)
  theme                   String  @default("system")
  autoShareRecognition    Boolean @default(true)
  dailyCheckinReminder    Boolean @default(true)
  weeklyReviewReminder    Boolean @default(true)
  reminderTime            String  @default("16:30")
  weeklyReviewReminderDay Int     @default(5)
  /// Application key the user is taken to on login / when hitting the home route. Null = the
  /// application launcher (`/apps`). Resolved against the apps the user currently has access to.
  defaultApplicationKey   String?
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CheckIn {
  id        String        @id @default(cuid())
  userId    String
  orgId     String
  status    CheckInStatus
  summary   String
  blockers  String?
  date      DateTime      @db.Date
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  org       Organization  @relation(fields: [orgId], references: [id])
  user      User          @relation("CheckInAuthor", fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([orgId, date])
  @@index([userId])
}

model Goal {
  id           String         @id @default(cuid())
  userId       String
  orgId        String
  title        String
  description  String?
  progress     Int            @default(0)
  status       GoalStatus     @default(active)
  dueDate      DateTime?
  completedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  assignedById String?
  visibility   GoalVisibility @default(personal)
  assignedBy   User?          @relation("GoalAssignedBy", fields: [assignedById], references: [id])
  org          Organization   @relation(fields: [orgId], references: [id])
  user         User           @relation("GoalOwner", fields: [userId], references: [id])
  history      GoalHistory[]

  @@index([orgId, status])
  @@index([orgId, visibility])
  @@index([userId])
}

model GoalHistory {
  id        String   @id @default(cuid())
  goalId    String
  progress  Int
  note      String?
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model WeeklyReview {
  id          String       @id @default(cuid())
  orgId       String
  revieweeId  String
  reviewerId  String
  type        ReviewType
  weekStart   DateTime     @db.Date
  wins        String?
  challenges  String?
  learning    String?
  feedback    String?
  rating      Int?
  status      ReviewStatus @default(draft)
  submittedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id])
  reviewee    User         @relation("RevieweeUser", fields: [revieweeId], references: [id])
  reviewer    User         @relation("ReviewerUser", fields: [reviewerId], references: [id])

  @@unique([revieweeId, reviewerId, type, weekStart])
  @@index([orgId, weekStart])
  @@index([revieweeId])
}

model Recognition {
  id          String       @id @default(cuid())
  orgId       String
  authorId    String
  recipientId String
  title       String
  note        String?
  createdAt   DateTime     @default(now())
  isPrivate   Boolean      @default(false)
  author      User         @relation("RecognitionAuthor", fields: [authorId], references: [id])
  org         Organization @relation(fields: [orgId], references: [id])
  recipient   User         @relation("RecognitionRecipient", fields: [recipientId], references: [id])

  @@index([orgId, createdAt])
  @@index([recipientId])
  @@index([authorId])
}

model Notification {
  id         String           @id @default(cuid())
  orgId      String
  userId     String
  type       NotificationType
  title      String
  body       String
  entityType String?
  entityId   String?
  actionUrl  String?
  metadata   Json?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  readAt     DateTime?
  org        Organization     @relation(fields: [orgId], references: [id])
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId, isRead, createdAt])
}

model PushDevice {
  id         String               @id @default(cuid())
  orgId      String
  userId     String
  platform   NotificationPlatform
  token      String               @unique
  browser    String?
  deviceName String?
  active     Boolean              @default(true)
  lastSeenAt DateTime             @default(now())
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  org        Organization         @relation(fields: [orgId], references: [id])
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId, active])
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  checkIns            Boolean  @default(true)
  reviews             Boolean  @default(true)
  recognition         Boolean  @default(true)
  goals               Boolean  @default(true)
  linearActivity      Boolean  @default(true)
  systemAnnouncements Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  workspace           Boolean  @default(true)
  checkInBlockers     Boolean  @default(true)
  weeklyDigest        Boolean  @default(true)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LinearIssue {
  id         String             @id @default(cuid())
  orgId      String
  linearId   String
  identifier String
  title      String
  url        String
  stateName  String
  stateType  LinearWorkflowType
  priority   Int?
  estimate   Float?
  dueDate    DateTime?
  assigneeId String?
  syncedAt   DateTime           @default(now())
  archivedAt DateTime?
  createdAt  DateTime           @default(now())
  assignee   User?              @relation("LinearIssueAssignee", fields: [assigneeId], references: [id])
  org        Organization       @relation(fields: [orgId], references: [id])
  updates    TaskUpdate[]

  @@unique([orgId, linearId])
  @@index([orgId, assigneeId])
  @@index([orgId, stateType])
}

model TaskUpdate {
  id               String                 @id @default(cuid())
  orgId            String
  issueId          String
  authorId         String
  body             String
  progress         Int?
  status           TaskUpdateStatus
  timeSpentMinutes Int?
  isEdited         Boolean                @default(false)
  editedAt         DateTime?
  isDeleted        Boolean                @default(false)
  deletedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  author           User                   @relation("TaskUpdateAuthor", fields: [authorId], references: [id])
  issue            LinearIssue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  org              Organization           @relation(fields: [orgId], references: [id])
  attachments      TaskUpdateAttachment[]

  @@index([orgId, issueId, createdAt])
  @@index([orgId, authorId, createdAt])
}

model TaskUpdateAttachment {
  id           String                   @id @default(cuid())
  taskUpdateId String
  kind         TaskUpdateAttachmentKind
  url          String
  fileName     String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime                 @default(now())
  taskUpdate   TaskUpdate               @relation(fields: [taskUpdateId], references: [id], onDelete: Cascade)

  @@index([taskUpdateId])
}

model WorkspaceItem {
  id              String                 @id @default(cuid())
  orgId           String
  ownerId         String
  assignedById    String?
  title           String
  description     String?
  status          WorkspaceStatus        @default(PENDING)
  priority        WorkspacePriority      @default(MEDIUM)
  dueDate         DateTime?
  source          WorkspaceSource        @default(MANUAL)
  reminderStage   WorkspaceReminderStage @default(NONE)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  completedAt     DateTime?
  archivedAt      DateTime?
  deletedAt       DateTime?
  isClientProject Boolean                @default(false)
  watcherIds      String[]               @default([])
  assignedBy      User?                  @relation("WorkspaceItemAssignedBy", fields: [assignedById], references: [id])
  org             Organization           @relation(fields: [orgId], references: [id])
  owner           User                   @relation("WorkspaceItemOwner", fields: [ownerId], references: [id])
  comments        WorkspaceItemComment[]

  @@index([orgId, ownerId, status, deletedAt])
  @@index([orgId, dueDate])
  @@index([assignedById])
}

model WorkspaceItemComment {
  id          String                           @id @default(cuid())
  itemId      String
  authorId    String
  body        String
  createdAt   DateTime                         @default(now())
  editedAt    DateTime?
  isEdited    Boolean                          @default(false)
  author      User                             @relation("WorkspaceCommentAuthor", fields: [authorId], references: [id])
  item        WorkspaceItem                    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attachments WorkspaceItemCommentAttachment[]

  @@index([itemId, createdAt])
}

model WorkspaceItemCommentAttachment {
  id        String                   @id @default(cuid())
  commentId String
  kind      TaskUpdateAttachmentKind
  url       String
  fileName  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime                 @default(now())
  comment   WorkspaceItemComment     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  appKey          String
  resource        String
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([appKey])
}

model AuthzRole {
  id                  String                   @id @default(cuid())
  key                 String                   @unique
  name                String
  scope               RoleScope
  isSystem            Boolean                  @default(true)
  description         String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  platformAssignments PlatformRoleAssignment[]
  rolePermissions     RolePermission[]
  userAssignments     UserRoleAssignment[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         AuthzRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  orgId     String?
  createdAt DateTime  @default(now())
  role      AuthzRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, orgId])
  @@index([userId])
  @@index([orgId])
}

model PlatformRoleAssignment {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime  @default(now())
  role      AuthzRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
}

model ApplicationInstallation {
  id             String            @id @default(cuid())
  orgId          String
  applicationKey String
  state          InstallationState @default(INSTALLED)
  installedAt    DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  org            Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, applicationKey])
  @@index([applicationKey])
}

model ApplicationConfiguration {
  id             String       @id @default(cuid())
  orgId          String
  applicationKey String
  config         Json         @default("{}")
  updatedAt      DateTime     @updatedAt
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, applicationKey])
  @@index([applicationKey])
}

/// Platform-wide audit trail of privileged actions (e.g. app-access grants, feature-flag flips).
/// Append-only by convention - the platform admin surface only ever reads and inserts. `actorId`
/// is the acting user's id (nullable so system events can be recorded); `metadata` carries the
/// action-specific payload.
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String?
  actorEmail String?
  targetType String?
  targetId   String?
  orgId      String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
}

/// Per-user access to an installable application, scoped to an organization. Deny-by-default:
/// a member sees an installable app only when a row exists here with `granted = true`. Managed
/// exclusively by a platform SUPER_ADMIN (who bypasses this check entirely). Platform-owned apps
/// (SUPER_ADMIN-only) and platform chrome (e.g. Settings) are NOT gated by this table.
model UserApplicationAccess {
  id             String       @id @default(cuid())
  orgId          String
  userId         String
  applicationKey String
  granted        Boolean      @default(true)
  /// User id of the SUPER_ADMIN who last changed this grant (audit; not a FK).
  grantedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, applicationKey])
  @@index([orgId])
  @@index([userId])
  @@index([applicationKey])
}

model CompanyProfile {
  id                             String       @id @default(cuid())
  orgId                          String       @unique
  legalName                      String
  displayName                    String?
  logoUrl                        String?
  addressLine1                   String?
  addressLine2                   String?
  city                           String?
  state                          String?
  postalCode                     String?
  country                        String       @default("India")
  gstin                          String?
  pan                            String?
  cin                            String?
  bankName                       String?
  bankAccountName                String?
  bankAccountNumber              String?
  bankIfsc                       String?
  upiId                          String?
  contactEmail                   String?
  contactPhone                   String?
  website                        String?
  invoiceFooterNotes             String?
  authorizedSignatoryName        String?
  authorizedSignatoryDesignation String?
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt
  org                            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Client {
  id                 String       @id @default(cuid())
  orgId              String
  type               ClientType   @default(COMPANY)
  name               String
  companyName        String?
  contactPersonName  String?
  email              String?
  phone              String?
  website            String?
  gstin              String?
  pan                String?
  taxId              String?
  billingLine1       String?
  billingLine2       String?
  billingCity        String?
  billingState       String?
  billingPostalCode  String?
  billingCountry     String?      @default("India")
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?
  notes              String?
  tags               String[]
  isActive           Boolean      @default(true)
  archivedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices           Invoice[]
  proposals          Proposal[]
  quotations         Quotation[]

  @@index([orgId])
  @@index([orgId, archivedAt])
}

model DocumentNumberSequence {
  id               String               @id @default(cuid())
  orgId            String
  documentType     BusinessDocumentType
  prefix           String               @default("")
  suffix           String               @default("")
  separator        String               @default("-")
  startNumber      Int                  @default(1)
  currentNumber    Int                  @default(0)
  padding          Int                  @default(6)
  resetMode        NumberResetMode      @default(NEVER)
  useFinancialYear Boolean              @default(false)
  periodKey        String               @default("")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  org              Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, documentType])
}

model Invoice {
  id              String        @id @default(cuid())
  orgId           String
  clientId        String?
  number          String?
  status          InvoiceStatus @default(DRAFT)
  currency        String        @default("INR")
  issueDate       DateTime?
  dueDate         DateTime?
  notes           String?
  terms           String?
  priceMode       String        @default("EXCLUSIVE")
  companySnapshot Json?
  clientSnapshot  Json?
  subtotal        Float         @default(0)
  discountTotal   Float         @default(0)
  taxableTotal    Float         @default(0)
  taxTotal        Float         @default(0)
  roundOff        Float         @default(0)
  grandTotal      Float         @default(0)
  taxBreakdown    Json?
  amountPaid      Float         @default(0)
  issuedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  invoiceType     InvoiceType   @default(STANDARD)
  clientName      String?
  client          Client?       @relation(fields: [clientId], references: [id])
  org             Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines           InvoiceLine[]
  payments        Payment[]

  @@index([orgId, status])
  @@index([orgId, clientId])
  @@index([orgId, issueDate])
}

model InvoiceLine {
  id           String  @id @default(cuid())
  invoiceId    String
  description  String
  quantity     Float   @default(1)
  unit         String?
  unitPrice    Float   @default(0)
  discount     Float   @default(0)
  discountType String  @default("PERCENT")
  taxes        Json?
  notes        String?
  lineTaxable  Float   @default(0)
  lineTax      Float   @default(0)
  lineTotal    Float   @default(0)
  sortOrder    Int     @default(0)
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Quotation {
  id              String          @id @default(cuid())
  orgId           String
  clientId        String?
  number          String?
  status          QuotationStatus @default(DRAFT)
  currency        String          @default("INR")
  issueDate       DateTime?
  expiryDate      DateTime?
  notes           String?
  terms           String?
  priceMode       String          @default("EXCLUSIVE")
  companySnapshot Json?
  clientSnapshot  Json?
  subtotal        Float           @default(0)
  discountTotal   Float           @default(0)
  taxableTotal    Float           @default(0)
  taxTotal        Float           @default(0)
  roundOff        Float           @default(0)
  grandTotal      Float           @default(0)
  taxBreakdown    Json?
  issuedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  clientName      String?
  client          Client?         @relation(fields: [clientId], references: [id])
  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines           QuotationLine[]

  @@index([orgId, status])
  @@index([orgId, clientId])
  @@index([orgId, issueDate])
}

model QuotationLine {
  id           String    @id @default(cuid())
  quotationId  String
  description  String
  quantity     Float     @default(1)
  unit         String?
  unitPrice    Float     @default(0)
  discount     Float     @default(0)
  discountType String    @default("PERCENT")
  taxes        Json?
  notes        String?
  lineTaxable  Float     @default(0)
  lineTax      Float     @default(0)
  lineTotal    Float     @default(0)
  sortOrder    Int       @default(0)
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model TaxConfig {
  id             String          @id @default(cuid())
  orgId          String          @unique
  regime         String          @default("IN_GST")
  homeCountry    String          @default("India")
  defaultGstRate Float           @default(18)
  defaultVatRate Float           @default(0)
  priceMode      TaxPriceMode    @default(EXCLUSIVE)
  roundingMode   TaxRoundingMode @default(NEAREST)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Proposal {
  id              String            @id @default(cuid())
  orgId           String
  clientId        String?
  title           String
  reference       String?
  summary         String?
  status          ProposalStatus    @default(DRAFT)
  validUntil      DateTime?
  companySnapshot Json?
  clientSnapshot  Json?
  sentAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  clientName      String?
  client          Client?           @relation(fields: [clientId], references: [id])
  org             Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sections        ProposalSection[]

  @@index([orgId, status])
  @@index([orgId, clientId])
}

model ProposalSection {
  id         String   @id @default(cuid())
  proposalId String
  title      String
  content    String   @default("")
  sortOrder  Int      @default(0)
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model Payment {
  id          String        @id @default(cuid())
  orgId       String
  invoiceId   String
  amount      Float
  paymentDate DateTime
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, invoiceId])
  @@index([orgId, paymentDate])
}

model OfferLetter {
  id                   String            @id @default(cuid())
  orgId                String
  number               String?
  status               OfferLetterStatus @default(DRAFT)
  offerDate            DateTime?
  validUntil           DateTime?
  candidateName        String
  candidateEmail       String
  candidatePhone       String?
  candidateAddress     String?
  position             String
  department           String?
  designation          String?
  reportingManager     String?
  startDate            DateTime?
  employmentType       EmploymentType    @default(FULL_TIME)
  workLocation         String?
  baseSalary           Float             @default(0)
  currency             String            @default("INR")
  variablePay          Float?
  salaryBreakdown      String?
  benefits             String?
  noticePeriod         String?
  probationPeriod      String?
  termsAndConditions   String?
  additionalNotes      String?
  companySnapshot      Json?
  sentAt               DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  bodyContent          String?
  signatoryUserId      String?
  signatoryName        String?
  signatoryDesignation String?
  signatureUrl         String?
  org                  Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([orgId, candidateEmail])
}

model OfferLetterTemplate {
  id             String         @id @default(cuid())
  orgId          String
  employmentType EmploymentType
  content        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  jobRole        String         @default("")
  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, employmentType, jobRole])
}

