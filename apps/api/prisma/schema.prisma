generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String                     @unique
  status                    OrgStatus                  @default(ACTIVE)
  logoUrl                   String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  linearApiKey              String?
  linearConnectedAt         DateTime?
  linearWorkspaceName       String?
  description               String?
  applicationConfigurations ApplicationConfiguration[]
  applicationInstallations  ApplicationInstallation[]
  userApplicationAccess     UserApplicationAccess[]
  checkIns                  CheckIn[]
  clients                   Client[]
  companyProfile            CompanyProfile?
  documentNumberSequences   DocumentNumberSequence[]
  goals                     Goal[]
  invitations               Invitation[]
  invoices                  Invoice[]
  linearIssues              LinearIssue[]
  memberships               Membership[]
  notifications             Notification[]
  offerLetters              OfferLetter[]
  documentTemplates         DocumentTemplate[]
  settings                  OrganizationSettings?
  payments                  Payment[]
  proposals                 Proposal[]
  pushDevices               PushDevice[]
  quotations                Quotation[]
  recognitions              Recognition[]
  taskUpdates               TaskUpdate[]
  taxConfig                 TaxConfig?
  users                     User[]
  reviews                   WeeklyReview[]
  workspaceItems            WorkspaceItem[]
  teams                     Team[]
  issues                    Issue[]
  issueLabels               IssueLabel[]
  issueStates               IssueState[]
  projects                  Project[]
  cycles                    Cycle[]
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  passwordHash             String
  firstName                String
  lastName                 String
  avatarUrl                String?
  orgId                    String
  managerId                String?
  department               String?
  jobTitle                 String?
  isActive                 Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  role                     Role                     @default(MEMBER)
  defaultOrganizationId    String?
  lastActiveOrganizationId String?
  signatureUrl             String?
  checkIns                 CheckIn[]                @relation("CheckInAuthor")
  goalsAssigned            Goal[]                   @relation("GoalAssignedBy")
  goals                    Goal[]                   @relation("GoalOwner")
  invitationsSent          Invitation[]             @relation("InvitedBy")
  linearIssueAssignments   LinearIssue[]            @relation("LinearIssueAssignee")
  memberships              Membership[]
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  switchLogs               OrganizationSwitchLog[]
  platformRoleAssignments  PlatformRoleAssignment[]
  pushDevices              PushDevice[]
  recognitionsGiven        Recognition[]            @relation("RecognitionAuthor")
  recognitionsReceived     Recognition[]            @relation("RecognitionRecipient")
  sessions                 Session[]
  taskUpdatesAuthored      TaskUpdate[]             @relation("TaskUpdateAuthor")
  manager                  User?                    @relation("UserManager", fields: [managerId], references: [id])
  reports                  User[]                   @relation("UserManager")
  org                      Organization             @relation(fields: [orgId], references: [id])
  preference               UserPreference?
  userRoleAssignments      UserRoleAssignment[]
  applicationAccess        UserApplicationAccess[]
  reviewsAsReviewee        WeeklyReview[]           @relation("RevieweeUser")
  reviewsAsReviewer        WeeklyReview[]           @relation("ReviewerUser")
  workspaceItemsAssigned   WorkspaceItem[]          @relation("WorkspaceItemAssignedBy")
  workspaceItemsOwned      WorkspaceItem[]          @relation("WorkspaceItemOwner")
  workspaceComments        WorkspaceItemComment[]   @relation("WorkspaceCommentAuthor")
  teamMemberships          TeamMember[]
  issuesCreated            Issue[]                  @relation("IssueCreator")
  issuesAssigned           Issue[]                  @relation("IssueAssignee")
  issueComments            IssueComment[]           @relation("IssueCommentAuthor")
  issueActivity            IssueActivity[]          @relation("IssueActivityActor")
  projectsLed              Project[]                @relation("ProjectLead")

  @@index([orgId])
  @@index([managerId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  id                    String           @id @default(cuid())
  userId                String
  orgId                 String
  role                  Role             @default(MEMBER)
  status                MembershipStatus @default(ACTIVE)
  managerId             String?
  department            String?
  jobTitle              String?
  joinedAt              DateTime?
  invitedByMembershipId String?
  lastSeenAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  invitedBy             Membership?      @relation("MembershipInviter", fields: [invitedByMembershipId], references: [id])
  invitees              Membership[]     @relation("MembershipInviter")
  manager               Membership?      @relation("MembershipManager", fields: [managerId], references: [id])
  reports               Membership[]     @relation("MembershipManager")
  org                   Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([managerId])
}

model OrganizationSwitchLog {
  id        String   @id @default(cuid())
  userId    String
  fromOrgId String?
  toOrgId   String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OrganizationSettings {
  id                 String       @id @default(cuid())
  orgId              String       @unique
  defaultRole        Role         @default(MEMBER)
  allowGuestAccess   Boolean      @default(false)
  invitationPolicy   String       @default("admin_only")
  onboardingDefaults Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          String           @id @default(cuid())
  orgId       String
  email       String
  token       String           @unique
  role        Role             @default(MEMBER)
  status      InvitationStatus @default(pending)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email, status])
  @@index([orgId])
  @@index([token])
}

model UserPreference {
  userId                  String  @id
  timezone                String  @default("UTC")
  emailNotifications      Boolean @default(true)
  theme                   String  @default("system")
  autoShareRecognition    Boolean @default(true)
  dailyCheckinReminder    Boolean @default(true)
  weeklyReviewReminder    Boolean @default(true)
  reminderTime            String  @default("16:30")
  weeklyReviewReminderDay Int     @default(5)
  /// Application key the user is taken to on login / when hitting the home route. Null = the
  /// application launcher (`/apps`). Resolved against the apps the user currently has access to.
  defaultApplicationKey   String?
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CheckIn {
  id        String        @id @default(cuid())
  userId    String
  orgId     String
  status    CheckInStatus
  summary   String
  blockers  String?
  date      DateTime      @db.Date
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  org       Organization  @relation(fields: [orgId], references: [id])
  user      User          @relation("CheckInAuthor", fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([orgId, date])
  @@index([userId])
}

model Goal {
  id           String         @id @default(cuid())
  userId       String
  orgId        String
  title        String
  description  String?
  progress     Int            @default(0)
  status       GoalStatus     @default(active)
  dueDate      DateTime?
  completedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  assignedById String?
  visibility   GoalVisibility @default(personal)
  assignedBy   User?          @relation("GoalAssignedBy", fields: [assignedById], references: [id])
  org          Organization   @relation(fields: [orgId], references: [id])
  user         User           @relation("GoalOwner", fields: [userId], references: [id])
  history      GoalHistory[]

  @@index([orgId, status])
  @@index([orgId, visibility])
  @@index([userId])
}

model GoalHistory {
  id        String   @id @default(cuid())
  goalId    String
  progress  Int
  note      String?
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model WeeklyReview {
  id          String       @id @default(cuid())
  orgId       String
  revieweeId  String
  reviewerId  String
  type        ReviewType
  weekStart   DateTime     @db.Date
  wins        String?
  challenges  String?
  learning    String?
  feedback    String?
  rating      Int?
  status      ReviewStatus @default(draft)
  submittedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id])
  reviewee    User         @relation("RevieweeUser", fields: [revieweeId], references: [id])
  reviewer    User         @relation("ReviewerUser", fields: [reviewerId], references: [id])

  @@unique([revieweeId, reviewerId, type, weekStart])
  @@index([orgId, weekStart])
  @@index([revieweeId])
}

model Recognition {
  id          String       @id @default(cuid())
  orgId       String
  authorId    String
  recipientId String
  title       String
  note        String?
  createdAt   DateTime     @default(now())
  isPrivate   Boolean      @default(false)
  author      User         @relation("RecognitionAuthor", fields: [authorId], references: [id])
  org         Organization @relation(fields: [orgId], references: [id])
  recipient   User         @relation("RecognitionRecipient", fields: [recipientId], references: [id])

  @@index([orgId, createdAt])
  @@index([recipientId])
  @@index([authorId])
}

model Notification {
  id         String           @id @default(cuid())
  orgId      String
  userId     String
  type       NotificationType
  title      String
  body       String
  entityType String?
  entityId   String?
  actionUrl  String?
  metadata   Json?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  readAt     DateTime?
  org        Organization     @relation(fields: [orgId], references: [id])
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId, isRead, createdAt])
}

model PushDevice {
  id         String               @id @default(cuid())
  orgId      String
  userId     String
  platform   NotificationPlatform
  token      String               @unique
  browser    String?
  deviceName String?
  active     Boolean              @default(true)
  lastSeenAt DateTime             @default(now())
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  org        Organization         @relation(fields: [orgId], references: [id])
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId, active])
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  checkIns            Boolean  @default(true)
  reviews             Boolean  @default(true)
  recognition         Boolean  @default(true)
  goals               Boolean  @default(true)
  linearActivity      Boolean  @default(true)
  systemAnnouncements Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  workspace           Boolean  @default(true)
  checkInBlockers     Boolean  @default(true)
  weeklyDigest        Boolean  @default(true)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LinearIssue {
  id         String             @id @default(cuid())
  orgId      String
  linearId   String
  identifier String
  title      String
  url        String
  stateName  String
  stateType  LinearWorkflowType
  priority   Int?
  estimate   Float?
  dueDate    DateTime?
  assigneeId String?
  syncedAt   DateTime           @default(now())
  archivedAt DateTime?
  createdAt  DateTime           @default(now())
  assignee   User?              @relation("LinearIssueAssignee", fields: [assigneeId], references: [id])
  org        Organization       @relation(fields: [orgId], references: [id])
  updates    TaskUpdate[]

  @@unique([orgId, linearId])
  @@index([orgId, assigneeId])
  @@index([orgId, stateType])
}

model TaskUpdate {
  id               String                 @id @default(cuid())
  orgId            String
  issueId          String
  authorId         String
  body             String
  progress         Int?
  status           TaskUpdateStatus
  timeSpentMinutes Int?
  isEdited         Boolean                @default(false)
  editedAt         DateTime?
  isDeleted        Boolean                @default(false)
  deletedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  author           User                   @relation("TaskUpdateAuthor", fields: [authorId], references: [id])
  issue            LinearIssue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  org              Organization           @relation(fields: [orgId], references: [id])
  attachments      TaskUpdateAttachment[]

  @@index([orgId, issueId, createdAt])
  @@index([orgId, authorId, createdAt])
}

model TaskUpdateAttachment {
  id           String                   @id @default(cuid())
  taskUpdateId String
  kind         TaskUpdateAttachmentKind
  url          String
  fileName     String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime                 @default(now())
  taskUpdate   TaskUpdate               @relation(fields: [taskUpdateId], references: [id], onDelete: Cascade)

  @@index([taskUpdateId])
}

model WorkspaceItem {
  id              String                 @id @default(cuid())
  orgId           String
  ownerId         String
  assignedById    String?
  title           String
  description     String?
  status          WorkspaceStatus        @default(PENDING)
  priority        WorkspacePriority      @default(MEDIUM)
  dueDate         DateTime?
  source          WorkspaceSource        @default(MANUAL)
  reminderStage   WorkspaceReminderStage @default(NONE)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  completedAt     DateTime?
  archivedAt      DateTime?
  deletedAt       DateTime?
  isClientProject Boolean                @default(false)
  watcherIds      String[]               @default([])
  assignedBy      User?                  @relation("WorkspaceItemAssignedBy", fields: [assignedById], references: [id])
  org             Organization           @relation(fields: [orgId], references: [id])
  owner           User                   @relation("WorkspaceItemOwner", fields: [ownerId], references: [id])
  comments        WorkspaceItemComment[]

  @@index([orgId, ownerId, status, deletedAt])
  @@index([orgId, dueDate])
  @@index([assignedById])
}

model Team {
  id           String       @id @default(cuid())
  orgId        String
  name         String
  key          String
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  archivedAt   DateTime?
  /// Last issue number handed out; issues are identified as `${key}-${number}`.
  issueCounter Int          @default(0)
  /// Last cycle number handed out.
  cycleCounter Int          @default(0)
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  issues       Issue[]
  labels       IssueLabel[]
  states       IssueState[]
  cycles       Cycle[]
  projects     Project[]    @relation("ProjectTeams")

  @@unique([orgId, key])
  @@index([orgId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

/// Internal, Linear-style issue tracker. Used by organizations that have not connected
/// Linear (orgs with Linear keep the Task Updates flow on LinearIssue).
model Issue {
  id          String          @id @default(cuid())
  orgId       String
  teamId      String
  number      Int
  title       String
  description String?
  /// The team's workflow state; its `category` drives lifecycle, progress and "open" filters.
  stateId     String
  priority    IssuePriority   @default(NONE)
  estimate    Int?
  dueDate     DateTime?
  /// Manual ordering within a status column / list.
  sortOrder   Float           @default(0)
  creatorId   String
  assigneeId  String?
  projectId   String?
  cycleId     String?
  parentId    String?
  startedAt   DateTime?
  completedAt DateTime?
  canceledAt  DateTime?
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  state       IssueState      @relation(fields: [stateId], references: [id])
  creator     User            @relation("IssueCreator", fields: [creatorId], references: [id])
  assignee    User?           @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cycle       Cycle?          @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  parent      Issue?          @relation("IssueSubIssues", fields: [parentId], references: [id], onDelete: SetNull)
  children    Issue[]         @relation("IssueSubIssues")
  labels      IssueLabel[]    @relation("IssueLabels")
  comments    IssueComment[]
  activity    IssueActivity[]

  @@unique([teamId, number])
  @@index([orgId, teamId, stateId, deletedAt])
  @@index([orgId, assigneeId])
  @@index([stateId])
  @@index([orgId, creatorId])
  @@index([projectId])
  @@index([cycleId])
  @@index([parentId])
}

/// A team's workflow status (Linear's "workflow state"). Teams name and colour their own,
/// but every state belongs to a fixed category the app reasons about.
model IssueState {
  id        String             @id @default(cuid())
  orgId     String
  teamId    String
  name      String
  color     String
  category  IssueStateCategory
  /// Order within the team's workflow (by category first, then this).
  position  Float              @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team      Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@unique([teamId, name])
  @@index([orgId, teamId])
}

model IssueLabel {
  id        String       @id @default(cuid())
  orgId     String
  /// Null = workspace-wide label, otherwise scoped to one team.
  teamId    String?
  name      String
  color     String       @default("#6b7280")
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team      Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issues    Issue[]      @relation("IssueLabels")

  @@unique([orgId, teamId, name])
  @@index([orgId])
}

model IssueComment {
  id        String    @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User      @relation("IssueCommentAuthor", fields: [authorId], references: [id])

  @@index([issueId, createdAt])
}

/// Field-level history shown on the issue detail page ("Aditi changed status Todo -> In Progress").
model IssueActivity {
  id        String   @id @default(cuid())
  issueId   String
  actorId   String
  /// created | status | priority | assignee | title | description | project | cycle | parent | labels | dueDate | estimate | archived
  field     String
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor     User     @relation("IssueActivityActor", fields: [actorId], references: [id])

  @@index([issueId, createdAt])
}

model Project {
  id          String        @id @default(cuid())
  orgId       String
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  leadId      String?
  startDate   DateTime?
  targetDate  DateTime?
  completedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead        User?         @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  teams       Team[]        @relation("ProjectTeams")
  issues      Issue[]

  @@index([orgId, status])
}

model Cycle {
  id          String       @id @default(cuid())
  orgId       String
  teamId      String
  number      Int
  name        String?
  startsAt    DateTime
  endsAt      DateTime
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issues      Issue[]

  @@unique([teamId, number])
  @@index([orgId, teamId, startsAt])
}

model WorkspaceItemComment {
  id          String                           @id @default(cuid())
  itemId      String
  authorId    String
  body        String
  createdAt   DateTime                         @default(now())
  editedAt    DateTime?
  isEdited    Boolean                          @default(false)
  author      User                             @relation("WorkspaceCommentAuthor", fields: [authorId], references: [id])
  item        WorkspaceItem                    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  attachments WorkspaceItemCommentAttachment[]

  @@index([itemId, createdAt])
}

model WorkspaceItemCommentAttachment {
  id        String                   @id @default(cuid())
  commentId String
  kind      TaskUpdateAttachmentKind
  url       String
  fileName  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime                 @default(now())
  comment   WorkspaceItemComment     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  appKey          String
  resource        String
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([appKey])
}

model AuthzRole {
  id                  String                   @id @default(cuid())
  key                 String                   @unique
  name                String
  scope               RoleScope
  isSystem            Boolean                  @default(true)
  description         String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  platformAssignments PlatformRoleAssignment[]
  rolePermissions     RolePermission[]
  userAssignments     UserRoleAssignment[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         AuthzRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  orgId     String?
  createdAt DateTime  @default(now())
  role      AuthzRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, orgId])
  @@index([userId])
  @@index([orgId])
}

model PlatformRoleAssignment {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime  @default(now())
  role      AuthzRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
}

model ApplicationInstallation {
  id             String            @id @default(cuid())
  orgId          String
  applicationKey String
  state          InstallationState @default(INSTALLED)
  installedAt    DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  org            Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, applicationKey])
  @@index([applicationKey])
}

model ApplicationConfiguration {
  id             String       @id @default(cuid())
  orgId          String
  applicationKey String
  config         Json         @default("{}")
  updatedAt      DateTime     @updatedAt
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, applicationKey])
  @@index([applicationKey])
}

/// Platform-wide audit trail of privileged actions (e.g. app-access grants, feature-flag flips).
/// Append-only by convention - the platform admin surface only ever reads and inserts. `actorId`
/// is the acting user's id (nullable so system events can be recorded); `metadata` carries the
/// action-specific payload.
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String?
  actorEmail String?
  targetType String?
  targetId   String?
  orgId      String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
}

/// Per-user access to an installable application, scoped to an organization. Deny-by-default:
/// a member sees an installable app only when a row exists here with `granted = true`. Managed
/// exclusively by a platform SUPER_ADMIN (who bypasses this check entirely). Platform-owned apps
/// (SUPER_ADMIN-only) and platform chrome (e.g. Settings) are NOT gated by this table.
model UserApplicationAccess {
  id             String       @id @default(cuid())
  orgId          String
  userId         String
  applicationKey String
  granted        Boolean      @default(true)
  /// User id of the SUPER_ADMIN who last changed this grant (audit; not a FK).
  grantedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, applicationKey])
  @@index([orgId])
  @@index([userId])
  @@index([applicationKey])
}

