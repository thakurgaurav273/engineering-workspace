model OfferLetter {
  id                   String            @id @default(cuid())
  orgId                String
  number               String?
  status               OfferLetterStatus @default(DRAFT)
  offerDate            DateTime?
  validUntil           DateTime?
  candidateName        String
  candidateEmail       String
  candidatePhone       String?
  candidateAddress     String?
  position             String
  department           String?
  designation          String?
  reportingManager     String?
  startDate            DateTime?
  employmentType       EmploymentType    @default(FULL_TIME)
  workLocation         String?
  baseSalary           Float             @default(0)
  currency             String            @default("INR")
  variablePay          Float?
  salaryBreakdown      String?
  benefits             String?
  noticePeriod         String?
  probationPeriod      String?
  termsAndConditions   String?
  additionalNotes      String?
  companySnapshot      Json?
  sentAt               DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  bodyContent          String?
  signatoryUserId      String?
  signatoryName        String?
  signatoryDesignation String?
  signatureUrl         String?
  /// Layout chosen for this document (null = the org's default for its type).
  templateId           String?
  /// Exact template version used once the document left DRAFT, so re-renders match.
  templateVersionId    String?
  org                  Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([orgId, candidateEmail])
}

/// An HTML + Liquid layout for one kind of business document (invoice, quotation, ...).
/// orgId null = a platform starter, managed by super admins and copyable by every org.
model DocumentTemplate {
  id                    String                    @id @default(cuid())
  orgId                 String?
  documentType          BusinessDocumentType
  /// Stable handle, unique within the org (e.g. "invoice_classic").
  key                   String
  name                  String
  description           String?
  status                DocumentTemplateStatus    @default(DRAFT)
  draftHtml             String
  /// Bumped on every draft save; saves must send the revision they started from.
  draftRevision         Int                       @default(1)
  draftUpdatedAt        DateTime                  @default(now())
  hasUnpublishedChanges Boolean                   @default(true)
  /// Version number currently live (null until first publish).
  liveVersion           Int?
  /// The org's default layout for this document type (published templates only).
  isDefault             Boolean                   @default(false)
  /// Offer letters only: the clause text a new offer starts from (null = built-in wording for
  /// the employment type). Copied into the offer when it's created, so it isn't versioned.
  defaultBody           String?
  createdById           String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  org                   Organization?             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions              DocumentTemplateVersion[]
  events                DocumentTemplateEvent[]

  @@unique([orgId, key])
  @@index([orgId, documentType])
}

/// An immutable published version. Issued documents point at one of these.
model DocumentTemplateVersion {
  id            String           @id @default(cuid())
  templateId    String
  version       Int
  html          String
  notes         String?
  publishedById String?
  createdAt     DateTime         @default(now())
  template      DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
}

model DocumentTemplateEvent {
  id         String           @id @default(cuid())
  templateId String
  /// created | details_updated | draft_discarded | published | rolled_back | set_default | archived | restored
  action     String
  version    Int?
  notes      String?
  actorId    String?
  createdAt  DateTime         @default(now())
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
}

