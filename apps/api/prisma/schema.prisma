  companyName        String?
  contactPersonName  String?
  email              String?
  phone              String?
  website            String?
  gstin              String?
  pan                String?
  taxId              String?
  billingLine1       String?
  billingLine2       String?
  billingCity        String?
  billingState       String?
  billingPostalCode  String?
  billingCountry     String?      @default("India")
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
