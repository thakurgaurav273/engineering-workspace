generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  linearApiKey        String?
  linearWorkspaceName String?
  linearConnectedAt   DateTime?

  users          User[]
  checkIns       CheckIn[]
  goals          Goal[]
  reviews        WeeklyReview[]
  recognitions   Recognition[]
  invitations    Invitation[]
  notifications  Notification[]
  pushDevices    PushDevice[]
  linearIssues   LinearIssue[]
  taskUpdates    TaskUpdate[]
  workspaceItems WorkspaceItem[]
  memberships    Membership[]
  settings       OrganizationSettings?

  applicationInstallations  ApplicationInstallation[]
  applicationConfigurations ApplicationConfiguration[]
  companyProfile            CompanyProfile?
  clients                   Client[]
  documentNumberSequences   DocumentNumberSequence[]
  taxConfig                 TaxConfig?
  invoices                  Invoice[]
  quotations                Quotation[]
  proposals                 Proposal[]
  payments                  Payment[]
  offerLetters              OfferLetter[]
}

model User {
  id                       String   @id @default(cuid())
  email                    String   @unique
  passwordHash             String
  firstName                String
  lastName                 String
  avatarUrl                String?
  // Legacy single-org fields — kept for backward compatibility. `Membership` is now the
  // source of truth; these mirror whichever org is `lastActiveOrganizationId` (see
  // AuthService.syncLegacyUserFields). Not dropped in this PR — see BACKLOG-ENGINEERING.md.
  orgId                    String
  managerId                String?
  department               String?
  jobTitle                 String?
  role                     Role     @default(MEMBER)
  isActive                 Boolean  @default(true)
  // Multi-org support
  defaultOrganizationId    String?
  lastActiveOrganizationId String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  org         Organization            @relation(fields: [orgId], references: [id])
  manager     User?                   @relation("UserManager", fields: [managerId], references: [id])
  reports     User[]                  @relation("UserManager")
  sessions    Session[]
  preference  UserPreference?
  memberships Membership[]
  switchLogs  OrganizationSwitchLog[]

  checkIns             CheckIn[]      @relation("CheckInAuthor")
  goals                Goal[]         @relation("GoalOwner")
  reviewsAsReviewee    WeeklyReview[] @relation("RevieweeUser")
  reviewsAsReviewer    WeeklyReview[] @relation("ReviewerUser")
  recognitionsGiven    Recognition[]  @relation("RecognitionAuthor")
  recognitionsReceived Recognition[]  @relation("RecognitionRecipient")
  invitationsSent      Invitation[]   @relation("InvitedBy")

  notifications          Notification[]
  pushDevices            PushDevice[]
  notificationPreference NotificationPreference?

  linearIssueAssignments LinearIssue[] @relation("LinearIssueAssignee")
  taskUpdatesAuthored    TaskUpdate[]  @relation("TaskUpdateAuthor")

  workspaceItemsOwned    WorkspaceItem[]        @relation("WorkspaceItemOwner")
  workspaceItemsAssigned WorkspaceItem[]        @relation("WorkspaceItemAssignedBy")
  workspaceComments      WorkspaceItemComment[] @relation("WorkspaceCommentAuthor")

  userRoleAssignments     UserRoleAssignment[]
  platformRoleAssignments PlatformRoleAssignment[]

  @@index([orgId])
  @@index([managerId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

// The authoritative per-(user, org) record: role, hierarchy, and profile fields that used
// to live directly on User now live here, so one person can belong to more than one org.
model Membership {
  id                    String           @id @default(cuid())
  userId                String
  orgId                 String
  role                  Role             @default(MEMBER)
  status                MembershipStatus @default(ACTIVE)
  managerId             String? // -> another Membership.id, same org
  department            String?
  jobTitle              String?
  joinedAt              DateTime? // set when status flips to ACTIVE; null while INVITED
  invitedByMembershipId String? // -> the inviter's Membership.id in this same org
  lastSeenAt            DateTime? // updated on login/switch into this org
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager   Membership?  @relation("MembershipManager", fields: [managerId], references: [id])
  reports   Membership[] @relation("MembershipManager")
  invitedBy Membership?  @relation("MembershipInviter", fields: [invitedByMembershipId], references: [id])
  invitees  Membership[] @relation("MembershipInviter")

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([managerId])
}

// Append-only audit trail of org switches (and initial org activations on login).
model OrganizationSwitchLog {
  id        String   @id @default(cuid())
  userId    String
  fromOrgId String? // null for the very first activation
  toOrgId   String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Schema-only for now — no service/controller wired up yet. Future-proofs org-level
// configuration (default role for new members, guest access, invitation policy,
// onboarding defaults) so later features don't need another migration for the table.
model OrganizationSettings {
  id                 String   @id @default(cuid())
  orgId              String   @unique
  defaultRole        Role     @default(MEMBER)
  allowGuestAccess   Boolean  @default(false)
  invitationPolicy   String   @default("admin_only")
  onboardingDefaults Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          String           @id @default(cuid())
  orgId       String
  email       String
  token       String           @unique
  role        Role             @default(MEMBER)
  status      InvitationStatus @default(pending)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@unique([orgId, email, status])
  @@index([orgId])
  @@index([token])
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

model UserPreference {
  userId             String  @id
  timezone           String  @default("UTC")
  emailNotifications Boolean @default(true)
  theme              String  @default("system")

  dailyCheckinReminder Boolean @default(true)
  weeklyReviewReminder Boolean @default(true)
  // "HH:mm" 24-hour local time (interpreted in `timezone`) - the daily check-in nudge
  // and weekly review nudge both fire at this time, on their respective days.
  reminderTime String @default("16:30")
  // 0 = Sunday .. 6 = Saturday. Default Friday, matching the reminder's original copy.
  weeklyReviewReminderDay Int @default(5)
  // Whether recognitions this user gives are visible in the org-wide feed (Recognition.isPrivate
  // is set from this at creation time) vs. kept just between author and recipient.
  autoShareRecognition Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CheckIn {
  id        String        @id @default(cuid())
  userId    String
  orgId     String
  status    CheckInStatus
  summary   String
  blockers  String?
  date      DateTime      @db.Date
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User         @relation("CheckInAuthor", fields: [userId], references: [id])
  org  Organization @relation(fields: [orgId], references: [id])

  @@unique([userId, date])
  @@index([orgId, date])
  @@index([userId])
}

enum CheckInStatus {
  on_track
  blocked
  completed
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  orgId       String
  title       String
  description String?
  progress    Int        @default(0)
  status      GoalStatus @default(active)
  dueDate     DateTime?
  completedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user    User          @relation("GoalOwner", fields: [userId], references: [id])
  org     Organization  @relation(fields: [orgId], references: [id])
  history GoalHistory[]

  @@index([orgId, status])
  @@index([userId])
}

enum GoalStatus {
  active
  completed
  archived
}

model GoalHistory {
  id        String   @id @default(cuid())
  goalId    String
  progress  Int
  note      String?
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model WeeklyReview {
  id          String       @id @default(cuid())
  orgId       String
  revieweeId  String
  reviewerId  String
  type        ReviewType
  weekStart   DateTime     @db.Date
  wins        String?
  challenges  String?
  learning    String?
  feedback    String?
  rating      Int?
  status      ReviewStatus @default(draft)
  submittedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org      Organization @relation(fields: [orgId], references: [id])
  reviewee User         @relation("RevieweeUser", fields: [revieweeId], references: [id])
  reviewer User         @relation("ReviewerUser", fields: [reviewerId], references: [id])

  @@unique([revieweeId, reviewerId, type, weekStart])
  @@index([orgId, weekStart])
  @@index([revieweeId])
}

enum ReviewType {
  self
  manager
}

enum ReviewStatus {
  draft
  submitted
}

model Recognition {
  id          String   @id @default(cuid())
  orgId       String
  authorId    String
  recipientId String
  title       String
  note        String?
  // Set from the author's UserPreference.autoShareRecognition at creation time - private
  // recognitions are excluded from the org-wide feed (still visible to author/recipient).
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id])
  author    User         @relation("RecognitionAuthor", fields: [authorId], references: [id])
  recipient User         @relation("RecognitionRecipient", fields: [recipientId], references: [id])

  @@index([orgId, createdAt])
  @@index([recipientId])
  @@index([authorId])
}

model Notification {
  id         String           @id @default(cuid())
  orgId      String
  userId     String
  type       NotificationType
  title      String
  body       String
  entityType String?
  entityId   String?
  actionUrl  String?
  metadata   Json?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  readAt     DateTime?

  org  Organization @relation(fields: [orgId], references: [id])
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId, isRead, createdAt])
}

model PushDevice {
  id         String               @id @default(cuid())
  orgId      String
  userId     String
  platform   NotificationPlatform
  token      String               @unique
  browser    String?
  deviceName String?
  active     Boolean              @default(true)
  lastSeenAt DateTime             @default(now())
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  org  Organization @relation(fields: [orgId], references: [id])
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId, active])
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  checkIns            Boolean  @default(true)
  checkInBlockers     Boolean  @default(true)
  reviews             Boolean  @default(true)
  recognition         Boolean  @default(true)
  goals               Boolean  @default(true)
  linearActivity      Boolean  @default(true)
  systemAnnouncements Boolean  @default(true)
  workspace           Boolean  @default(true)
  weeklyDigest        Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationPlatform {
  WEB
  ANDROID
  IOS
}

enum NotificationType {
  CHECK_IN_CREATED
  CHECK_IN_REMINDER
  CHECK_IN_BLOCKED
  WEEKLY_REVIEW_REMINDER
  WEEKLY_DIGEST
  GOAL_ASSIGNED
  GOAL_UPDATED
  RECOGNITION_RECEIVED
  REVIEW_REQUESTED
  REVIEW_COMPLETED
  LINEAR_ISSUE_ASSIGNED
  LINEAR_ISSUE_UPDATED
  TASK_UPDATE_POSTED
  SYSTEM
  WORKSPACE_ITEM_ASSIGNED
  WORKSPACE_ITEM_REMINDER
  WORKSPACE_ITEM_COMMENT
  WORKSPACE_ITEM_STATUS_CHANGED
}

model LinearIssue {
  id         String             @id @default(cuid())
  orgId      String
  linearId   String
  identifier String
  title      String
  url        String
  stateName  String
  stateType  LinearWorkflowType
  priority   Int?
  estimate   Float?
  dueDate    DateTime?
  assigneeId String?
  syncedAt   DateTime           @default(now())
  archivedAt DateTime?
  createdAt  DateTime           @default(now())

  org      Organization @relation(fields: [orgId], references: [id])
  assignee User?        @relation("LinearIssueAssignee", fields: [assigneeId], references: [id])
  updates  TaskUpdate[]

  @@unique([orgId, linearId])
  @@index([orgId, assigneeId])
  @@index([orgId, stateType])
}

enum LinearWorkflowType {
  backlog
  unstarted
  started
  completed
  canceled
}

model TaskUpdate {
  id               String           @id @default(cuid())
  orgId            String
  issueId          String
  authorId         String
  body             String           @db.Text
  progress         Int?
  status           TaskUpdateStatus
  timeSpentMinutes Int?
  isEdited         Boolean          @default(false)
  editedAt         DateTime?
  isDeleted        Boolean          @default(false)
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  org         Organization           @relation(fields: [orgId], references: [id])
  issue       LinearIssue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author      User                   @relation("TaskUpdateAuthor", fields: [authorId], references: [id])
  attachments TaskUpdateAttachment[]

  @@index([orgId, issueId, createdAt])
  @@index([orgId, authorId, createdAt])
}

enum TaskUpdateStatus {
  on_track
  at_risk
  blocked
  in_review
  done
}

model TaskUpdateAttachment {
  id           String                   @id @default(cuid())
  taskUpdateId String
  kind         TaskUpdateAttachmentKind
  url          String
  fileName     String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime                 @default(now())

  taskUpdate TaskUpdate @relation(fields: [taskUpdateId], references: [id], onDelete: Cascade)

  @@index([taskUpdateId])
}

enum TaskUpdateAttachmentKind {
  file
  image
  voice_note
}

// "My Workspace" - a personal planning space for reminders, follow-ups, and action
// items that originate outside Linear (Slack/WhatsApp/email/calls/meetings). Linear
// stays the source of truth for engineering work; this model never syncs with it.
model WorkspaceItem {
  id              String                 @id @default(cuid())
  orgId           String
  ownerId         String
  assignedById    String?
  title           String
  description     String?                @db.Text
  status          WorkspaceStatus        @default(PENDING)
  priority        WorkspacePriority      @default(MEDIUM)
  dueDate         DateTime?
  source          WorkspaceSource        @default(MANUAL)
  reminderStage   WorkspaceReminderStage @default(NONE)
  isClientProject Boolean                @default(false)
  // Everyone who has ever owned or assigned this item, accumulated on each delegation —
  // so re-delegating down a chain (admin -> senior -> junior) still notifies everyone
  // upstream, not just the immediate assigner (which gets overwritten on each hop).
  watcherIds      String[]               @default([])
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  completedAt     DateTime?
  archivedAt      DateTime?
  deletedAt       DateTime?

  org        Organization           @relation(fields: [orgId], references: [id])
  owner      User                   @relation("WorkspaceItemOwner", fields: [ownerId], references: [id])
  assignedBy User?                  @relation("WorkspaceItemAssignedBy", fields: [assignedById], references: [id])
  comments   WorkspaceItemComment[]

  @@index([orgId, ownerId, status, deletedAt])
  @@index([orgId, dueDate])
  @@index([assignedById])
}

model WorkspaceItemComment {
  id        String   @id @default(cuid())
  itemId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  item   WorkspaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author User          @relation("WorkspaceCommentAuthor", fields: [authorId], references: [id])

  @@index([itemId, createdAt])
}

enum WorkspaceStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum WorkspacePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkspaceSource {
  MANUAL
  LINEAR
  SLACK
  WHATSAPP
  EMAIL
  MEETING
  PHONE_CALL
  OTHER
}

enum WorkspaceReminderStage {
  NONE
  DUE_SOON
  DUE_TODAY
  OVERDUE
}

// ---------------------------------------------------------------------------
// Platform Authorization (Phase 1). Additive; the legacy `Role` enum + Membership
// remain the authoritative org-role source. These tables back the PDP (shadow mode).
// The role model is named `AuthzRole` because `enum Role` already exists.
// ---------------------------------------------------------------------------

enum RoleScope {
  PLATFORM
  ORG
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // app:resource:action
  appKey      String
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([appKey])
}

model AuthzRole {
  id          String    @id @default(cuid())
  key         String    @unique // SUPER_ADMIN, OWNER, ADMIN, MANAGER, MEMBER
  name        String
  scope       RoleScope
  isSystem    Boolean   @default(true)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions     RolePermission[]
  userAssignments     UserRoleAssignment[]
  platformAssignments PlatformRoleAssignment[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       AuthzRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

// Future custom / org-scoped role grants. Org membership roles are NOT duplicated here —
// they stay on Membership. Empty until custom roles ship.
model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  orgId     String?
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AuthzRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, orgId])
  @@index([userId])
  @@index([orgId])
}

// Persistent SUPER_ADMIN grants (complements the env allowlist in PlatformRoleService).
model PlatformRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AuthzRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Application Installation (Phase 2). Per-organization install state + generic config.
// Applications stay registered globally (code/registry); only their state is per-org.
// `applicationKey` is the registry key (no Application table). Config is a separate table
// so it survives uninstall.
// ---------------------------------------------------------------------------

enum InstallationState {
  INSTALLED
  DISABLED
  MAINTENANCE
  UNINSTALLED
}

model ApplicationInstallation {
  id             String            @id @default(cuid())
  orgId          String
  applicationKey String
  state          InstallationState @default(INSTALLED)
  installedAt    DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, applicationKey])
  @@index([applicationKey])
}

model ApplicationConfiguration {
  id             String   @id @default(cuid())
  orgId          String
  applicationKey String
  config         Json     @default("{}")
  updatedAt      DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, applicationKey])
  @@index([applicationKey])
}

// ---------------------------------------------------------------------------
// Business Operations — Company Profile (Phase 3). Per-organization company identity
// used on business documents. Replaces the legacy single-tenant Company singleton.
// Document numbering config lives in the Numbering module, not here.
// ---------------------------------------------------------------------------

model CompanyProfile {
  id          String  @id @default(cuid())
  orgId       String  @unique
  legalName   String
  displayName String?
  logoUrl     String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String  @default("India")

  gstin String?
  pan   String?
  cin   String?

  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?

  contactEmail String?
  contactPhone String?
  website      String?

  invoiceFooterNotes             String?
  authorizedSignatoryName        String?
  authorizedSignatoryDesignation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Business Operations — Clients (Phase 3). Org-scoped customer records. Soft delete
// only (archivedAt). Future-ready for invoices/quotations/proposals/payments (they will
// reference clientId later; no FK is added from here yet).
// ---------------------------------------------------------------------------

enum ClientType {
  COMPANY
  INDIVIDUAL
}

model Client {
  id                String     @id @default(cuid())
  orgId             String
  type              ClientType @default(COMPANY)
  name              String
  companyName       String?
  contactPersonName String?
  email             String?
  phone             String?
  website           String?

  gstin String?
  pan   String?
  taxId String?

  billingLine1      String?
  billingLine2      String?
  billingCity       String?
  billingState      String?
  billingPostalCode String?
  billingCountry    String? @default("India")

  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?

  notes    String?
  tags     String[]
  isActive Boolean   @default(true)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices   Invoice[]
  quotations Quotation[]
  proposals  Proposal[]

  @@index([orgId])
  @@index([orgId, archivedAt])
}

// ---------------------------------------------------------------------------
// Business Operations — Document Numbering (Phase 3, module 3). One config row per
// organization + document type. Single source of truth for all business document numbers
// (invoices, quotations, etc). next() reserves atomically (see the service).
// ---------------------------------------------------------------------------

enum BusinessDocumentType {
  INVOICE
  QUOTATION
  OFFER_LETTER
  PROPOSAL
  PURCHASE_ORDER
  RECEIPT
  CREDIT_NOTE
  DELIVERY_NOTE
}

enum NumberResetMode {
  NEVER
  YEARLY
  MONTHLY
}

model DocumentNumberSequence {
  id               String               @id @default(cuid())
  orgId            String
  documentType     BusinessDocumentType
  prefix           String               @default("")
  suffix           String               @default("")
  separator        String               @default("-")
  startNumber      Int                  @default(1)
  currentNumber    Int                  @default(0) // last issued number (0 = none yet)
  padding          Int                  @default(6)
  resetMode        NumberResetMode      @default(NEVER)
  useFinancialYear Boolean              @default(false)
  periodKey        String               @default("") // reset-tracking key for currentNumber

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, documentType])
}

// ---------------------------------------------------------------------------
// Business Operations — Invoices (Phase 3, module 5). The first real business document.
// Orchestrates Company/Client/Numbering/Tax services — computes nothing itself. Stores
// snapshots + calculated totals + tax breakdown. Number reserved at ISSUE (never reused).
// amountPaid is the extension point for the future Payments module.
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
  VOID
}

model Invoice {
  id       String        @id @default(cuid())
  orgId    String
  clientId String
  number   String? // reserved at ISSUE via DocumentNumberingService; null while DRAFT
  status   InvoiceStatus @default(DRAFT)
  currency String        @default("INR")

  issueDate DateTime?
  dueDate   DateTime?
  notes     String?
  terms     String?
  priceMode String    @default("EXCLUSIVE")

  companySnapshot Json?
  clientSnapshot  Json?

  subtotal      Float @default(0)
  discountTotal Float @default(0)
  taxableTotal  Float @default(0)
  taxTotal      Float @default(0)
  roundOff      Float @default(0)
  grandTotal    Float @default(0)
  taxBreakdown  Json?

  amountPaid Float     @default(0)
  issuedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client   Client        @relation(fields: [clientId], references: [id])
  lines    InvoiceLine[]
  payments Payment[]

  @@index([orgId, status])
  @@index([orgId, clientId])
  @@index([orgId, issueDate])
}

model InvoiceLine {
  id           String  @id @default(cuid())
  invoiceId    String
  description  String
  quantity     Float   @default(1)
  unit         String?
  unitPrice    Float   @default(0)
  discount     Float   @default(0)
  discountType String  @default("PERCENT")
  taxes        Json?
  notes        String?
  lineTaxable  Float   @default(0)
  lineTax      Float   @default(0)
  lineTotal    Float   @default(0)
  sortOrder    Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Business Operations — Quotations (Phase 3, module 6). Mirrors Invoice; orchestration
// only. Number reserved at ISSUE via DocumentNumberingService('QUOTATION').
// ---------------------------------------------------------------------------

enum QuotationStatus {
  DRAFT
  ISSUED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model Quotation {
  id       String          @id @default(cuid())
  orgId    String
  clientId String
  number   String?
  status   QuotationStatus @default(DRAFT)
  currency String          @default("INR")

  issueDate  DateTime?
  expiryDate DateTime?
  notes      String?
  terms      String?
  priceMode  String    @default("EXCLUSIVE")

  companySnapshot Json?
  clientSnapshot  Json?

  subtotal      Float @default(0)
  discountTotal Float @default(0)
  taxableTotal  Float @default(0)
  taxTotal      Float @default(0)
  roundOff      Float @default(0)
  grandTotal    Float @default(0)
  taxBreakdown  Json?

  issuedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client Client          @relation(fields: [clientId], references: [id])
  lines  QuotationLine[]

  @@index([orgId, status])
  @@index([orgId, clientId])
  @@index([orgId, issueDate])
}

model QuotationLine {
  id           String  @id @default(cuid())
  quotationId  String
  description  String
  quantity     Float   @default(1)
  unit         String?
  unitPrice    Float   @default(0)
  discount     Float   @default(0)
  discountType String  @default("PERCENT")
  taxes        Json?
  notes        String?
  lineTaxable  Float   @default(0)
  lineTax      Float   @default(0)
  lineTotal    Float   @default(0)
  sortOrder    Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

// ---------------------------------------------------------------------------
// Business Operations — Tax configuration (Phase 3, module 4). Per-organization defaults
// for the canonical tax engine. The engine itself is pure code; this stores an org's
// preferred rates/modes. Region-extensible via `regime` (IN_GST today, GCC_VAT later).
// ---------------------------------------------------------------------------

enum TaxPriceMode {
  EXCLUSIVE
  INCLUSIVE
}

enum TaxRoundingMode {
  NONE
  NEAREST
  UP
  DOWN
}

model TaxConfig {
  id             String          @id @default(cuid())
  orgId          String          @unique
  regime         String          @default("IN_GST")
  homeCountry    String          @default("India")
  defaultGstRate Float           @default(18)
  defaultVatRate Float           @default(0)
  priceMode      TaxPriceMode    @default(EXCLUSIVE)
  roundingMode   TaxRoundingMode @default(NEAREST)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Business Operations — Proposals (Phase 3, module 7). NOT a financial document:
// no Tax Engine, no Document Numbering, no totals. A commercial proposal is a
// titled document of ordered rich-text (HTML) sections. Company/Client snapshots
// are captured from CompanyService/ClientsService at write time. Read-only once SENT.
// ---------------------------------------------------------------------------

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  REJECTED
  ARCHIVED
}

model Proposal {
  id        String         @id @default(cuid())
  orgId     String
  clientId  String
  title     String
  reference String?
  summary   String?
  status    ProposalStatus @default(DRAFT)

  validUntil DateTime?

  companySnapshot Json?
  clientSnapshot  Json?

  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client   Client            @relation(fields: [clientId], references: [id])
  sections ProposalSection[]

  @@index([orgId, status])
  @@index([orgId, clientId])
}

model ProposalSection {
  id         String @id @default(cuid())
  proposalId String
  title      String
  content    String @default("") // plain rich-text HTML
  sortOrder  Int    @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

// ---------------------------------------------------------------------------
// Business Operations — Payments (Phase 3, module 8). Records money received
// against an issued Invoice. Recording/removing a payment recomputes the parent
// invoice's amountPaid (sum of payments) and derives its status (PARTIALLY_PAID /
// PAID). Invoice remains the single source of truth for totals; payments never
// touch the Tax Engine.
// ---------------------------------------------------------------------------

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CARD
  CASH
  CHEQUE
  STRIPE
  RAZORPAY
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  orgId       String
  invoiceId   String
  amount      Float
  paymentDate DateTime
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String? // transaction id / UPI ref / cheque no
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([orgId, invoiceId])
  @@index([orgId, paymentDate])
}

// ---------------------------------------------------------------------------
// Business Operations — Offer Letters (Phase 3, module 9). An HR document for a
// candidate (not a client). Non-financial: no Tax Engine. A permanent number is
// reserved at SEND via DocumentNumberingService('OFFER_LETTER'). Editable while
// DRAFT; read-only once SENT.
// ---------------------------------------------------------------------------

enum OfferLetterStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

model OfferLetter {
  id     String            @id @default(cuid())
  orgId  String
  number String? // reserved at SEND via DocumentNumberingService('OFFER_LETTER')
  status OfferLetterStatus @default(DRAFT)

  offerDate  DateTime?
  validUntil DateTime?

  candidateName    String
  candidateEmail   String
  candidatePhone   String?
  candidateAddress String?

  position         String
  department       String?
  designation      String?
  reportingManager String?
  startDate        DateTime?
  employmentType   EmploymentType @default(FULL_TIME)
  workLocation     String?

  baseSalary      Float   @default(0)
  currency        String  @default("INR")
  variablePay     Float?
  salaryBreakdown String?
  benefits        String?

  noticePeriod       String?
  probationPeriod    String?
  termsAndConditions String?
  additionalNotes    String?

  companySnapshot Json?

  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([orgId, candidateEmail])
}
