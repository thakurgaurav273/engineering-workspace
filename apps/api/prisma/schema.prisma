model DocumentNumberSequence {
  id               String               @id @default(cuid())
  orgId            String
  documentType     BusinessDocumentType
  prefix           String               @default("")
  suffix           String               @default("")
  separator        String               @default("-")
  startNumber      Int                  @default(1)
  currentNumber    Int                  @default(0)
  padding          Int                  @default(6)
  resetMode        NumberResetMode      @default(NEVER)
  useFinancialYear Boolean              @default(false)
  periodKey        String               @default("")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  org              Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, documentType])
}

model Invoice {
  id                String           @id @default(cuid())
  orgId             String
  clientId          String?
  number            String?
  status            InvoiceStatus    @default(DRAFT)
  currency          String           @default("INR")
  issueDate         DateTime?
  dueDate           DateTime?
  notes             String?
  terms             String?
  priceMode         String           @default("EXCLUSIVE")
  companySnapshot   Json?
  clientSnapshot    Json?
  subtotal          Float            @default(0)
  discountTotal     Float            @default(0)
  taxableTotal      Float            @default(0)
  taxTotal          Float            @default(0)
  roundOff          Float            @default(0)
  grandTotal        Float            @default(0)
  taxBreakdown      Json?
  amountPaid        Float            @default(0)
  issuedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  invoiceType       InvoiceType      @default(STANDARD)
  clientName        String?
  client            Client?          @relation(fields: [clientId], references: [id])
  /// Layout chosen for this document (null = the org's default for its type).
  templateId        String?
  /// Exact template version used once the document left DRAFT, so re-renders match.
  templateVersionId String?
  org               Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines             InvoiceLine[]
  sections          InvoiceSection[]
  payments          Payment[]

  @@index([orgId, status])
  @@index([orgId, clientId])
  @@index([orgId, issueDate])
}

/// Rich, ordered content sections of an invoice (Project Details, Deliverables, etc.). Mirrors
/// QuotationSection/ProposalSection — title + HTML content + order. Non-financial, PDF-rendered.
model InvoiceSection {
  id        String  @id @default(cuid())
  invoiceId String
  title     String
  content   String  @default("")
  sortOrder Int     @default(0)
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceLine {
  id           String  @id @default(cuid())
  invoiceId    String
  description  String
  quantity     Float   @default(1)
  unit         String?
  unitPrice    Float   @default(0)
  discount     Float   @default(0)
  discountType String  @default("PERCENT")
  taxes        Json?
  notes        String?
  lineTaxable  Float   @default(0)
  lineTax      Float   @default(0)
  lineTotal    Float   @default(0)
  sortOrder    Int     @default(0)
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Quotation {
  id                String             @id @default(cuid())
  orgId             String
  clientId          String?
  number            String?
  status            QuotationStatus    @default(DRAFT)
  currency          String             @default("INR")
  issueDate         DateTime?
  expiryDate        DateTime?
  notes             String?
  terms             String?
  priceMode         String             @default("EXCLUSIVE")
  companySnapshot   Json?
  clientSnapshot    Json?
  subtotal          Float              @default(0)
  discountTotal     Float              @default(0)
  taxableTotal      Float              @default(0)
  taxTotal          Float              @default(0)
  roundOff          Float              @default(0)
  grandTotal        Float              @default(0)
  taxBreakdown      Json?
  issuedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  clientName        String?
  client            Client?            @relation(fields: [clientId], references: [id])
  /// Layout chosen for this document (null = the org's default for its type).
  templateId        String?
  /// Exact template version used once the document left DRAFT, so re-renders match.
  templateVersionId String?
  org               Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines             QuotationLine[]
  sections          QuotationSection[]

  @@index([orgId, status])
  @@index([orgId, clientId])
  @@index([orgId, issueDate])
}

/// Rich, ordered content sections of a quotation (Project Scope, Deliverables, etc.). Mirrors
/// ProposalSection — title + HTML content + order. New quotations are pre-seeded with a default
/// set; users edit, reorder, add and remove sections freely.
model QuotationSection {
  id          String    @id @default(cuid())
  quotationId String
  title       String
  content     String    @default("")
  sortOrder   Int       @default(0)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model QuotationLine {
  id           String    @id @default(cuid())
