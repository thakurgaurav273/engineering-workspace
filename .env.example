# --- Local dev (Next.js dev server, `npm run dev`) ---
# apps/web reads these from apps/web/.env. NEXT_PUBLIC_* are inlined into the
# client bundle at build time.
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Platform branding (product name/tagline/logo) - shown on sign-in and wherever no
# organization is in scope; inside the app each organization's own name and logo
# (Settings -> Organization) take over. Logo: absolute URL or a path under apps/web/public.
# docker-compose also passes these to the api (as APP_*) for emails.
# Empty name = "Workspace"; empty logo = a monogram of the name.
NEXT_PUBLIC_APP_NAME=""
NEXT_PUBLIC_APP_TAGLINE=""
NEXT_PUBLIC_APP_LOGO_URL=""
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
NEXT_PUBLIC_FLAG_REGISTRY_NAV="true"
NEXT_PUBLIC_FLAG_PLATFORM_SHELL="true"

# --- docker-compose / Dokploy deployment only (root docker-compose.yml) ---
# Set these in Dokploy's environment variables UI for the Compose application,
# not in a committed .env file. Every variable below is required except
# POSTGRES_USER, POSTGRES_DB, and the two JWT_*_EXPIRES_IN, which have defaults.
#
# The NEXT_PUBLIC_* values above are also required here: they are passed to the
# web image as build args, so a missing value is baked into the bundle as empty.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="grovyn_one"
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Platform super-admins: comma-separated emails granted SUPER_ADMIN (above any org
# Owner). Read from env by PlatformRoleService - NOT stored in the DB, so it does not
# travel with a prod->staging data restore; set it per environment. Empty = none.
PLATFORM_SUPER_ADMINS=""
FRONTEND_URL="https://tracker.grovyn.in"
RESEND_API_KEY=""
MAIL_FROM="Grovyn One <onboarding@grovyn.in>"
ENCRYPTION_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Staging safety kill switch. Set STAGING_SAFE_MODE="true" on the STAGING compose
# app (never prod). It stops all scheduled cron jobs and blocks the mail + push
# providers, so a staging box seeded with restored production data cannot email
# real users, push to real devices, or sync real Linear workspaces.
STAGING_SAFE_MODE=""

# Object storage (avatar / file uploads): Cloudflare R2 OR Cloudinary. With neither fully
# configured the API disables uploads ("File uploads are not available right now").
# STORAGE_PROVIDER picks one ("r2" | "cloudinary"); empty = whichever is configured, R2 first.
STORAGE_PROVIDER=""
# Cloudflare R2 - all five required. R2_PUBLIC_URL: the bucket's r2.dev URL or a custom
# domain on a Cloudflare-managed zone.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
# Cloudinary - the three values, or CLOUDINARY_URL (cloudinary://<key>:<secret>@<cloud>).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""
