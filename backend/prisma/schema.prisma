generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  linearApiKey        String?
  linearWorkspaceName String?
  linearConnectedAt   DateTime?

  users         User[]
  checkIns      CheckIn[]
  goals         Goal[]
  reviews       WeeklyReview[]
  recognitions  Recognition[]
  invitations   Invitation[]
  notifications Notification[]
  pushDevices   PushDevice[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  orgId        String
  managerId    String?
  department   String?
  jobTitle     String?
  role         Role     @default(MEMBER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org        Organization    @relation(fields: [orgId], references: [id])
  manager    User?           @relation("UserManager", fields: [managerId], references: [id])
  reports    User[]          @relation("UserManager")
  sessions   Session[]
  preference UserPreference?

  checkIns             CheckIn[]      @relation("CheckInAuthor")
  goals                Goal[]         @relation("GoalOwner")
  reviewsAsReviewee    WeeklyReview[] @relation("RevieweeUser")
  reviewsAsReviewer    WeeklyReview[] @relation("ReviewerUser")
  recognitionsGiven    Recognition[]  @relation("RecognitionAuthor")
  recognitionsReceived Recognition[]  @relation("RecognitionRecipient")
  invitationsSent      Invitation[]   @relation("InvitedBy")

  notifications          Notification[]
  pushDevices            PushDevice[]
  notificationPreference NotificationPreference?

  @@index([orgId])
  @@index([managerId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id          String           @id @default(cuid())
  orgId       String
  email       String
  token       String           @unique
  role        Role             @default(MEMBER)
  status      InvitationStatus @default(pending)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@unique([orgId, email, status])
  @@index([orgId])
  @@index([token])
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

model UserPreference {
  userId             String  @id
  timezone           String  @default("UTC")
  emailNotifications Boolean @default(true)
  weeklyDigest       Boolean @default(true)
  theme              String  @default("system")

  dailyCheckinReminder  Boolean @default(true)
  weeklyReviewReminder  Boolean @default(true)
  autoShareRecognition  Boolean @default(false)
  showMenteeSuggestions Boolean @default(true)
  notifyNewRecognition  Boolean @default(true)
  notifyCheckInBlockers Boolean @default(true)
  notifyReviewRequests  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CheckIn {
  id        String        @id @default(cuid())
  userId    String
  orgId     String
  status    CheckInStatus
  summary   String
  blockers  String?
  date      DateTime      @db.Date
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User         @relation("CheckInAuthor", fields: [userId], references: [id])
  org  Organization @relation(fields: [orgId], references: [id])

  @@unique([userId, date])
  @@index([orgId, date])
  @@index([userId])
}

enum CheckInStatus {
  on_track
  blocked
  completed
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  orgId       String
  title       String
  description String?
  progress    Int        @default(0)
  status      GoalStatus @default(active)
  dueDate     DateTime?
  completedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user    User          @relation("GoalOwner", fields: [userId], references: [id])
  org     Organization  @relation(fields: [orgId], references: [id])
  history GoalHistory[]

  @@index([orgId, status])
  @@index([userId])
}

enum GoalStatus {
  active
  completed
  archived
}

model GoalHistory {
  id        String   @id @default(cuid())
  goalId    String
  progress  Int
  note      String?
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model WeeklyReview {
  id          String       @id @default(cuid())
  orgId       String
  revieweeId  String
  reviewerId  String
  type        ReviewType
  weekStart   DateTime     @db.Date
  wins        String?
  challenges  String?
  learning    String?
  feedback    String?
  rating      Int?
  status      ReviewStatus @default(draft)
  submittedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org      Organization @relation(fields: [orgId], references: [id])
  reviewee User         @relation("RevieweeUser", fields: [revieweeId], references: [id])
  reviewer User         @relation("ReviewerUser", fields: [reviewerId], references: [id])

  @@unique([revieweeId, reviewerId, type, weekStart])
  @@index([orgId, weekStart])
  @@index([revieweeId])
}

enum ReviewType {
  self
  manager
}

enum ReviewStatus {
  draft
  submitted
}

model Recognition {
  id          String   @id @default(cuid())
  orgId       String
  authorId    String
  recipientId String
  title       String
  note        String?
  createdAt   DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id])
  author    User         @relation("RecognitionAuthor", fields: [authorId], references: [id])
  recipient User         @relation("RecognitionRecipient", fields: [recipientId], references: [id])

  @@index([orgId, createdAt])
  @@index([recipientId])
  @@index([authorId])
}

model Notification {
  id         String           @id @default(cuid())
  orgId      String
  userId     String
  type       NotificationType
  title      String
  body       String
  entityType String?
  entityId   String?
  actionUrl  String?
  metadata   Json?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  readAt     DateTime?

  org  Organization @relation(fields: [orgId], references: [id])
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId, isRead, createdAt])
}

model PushDevice {
  id         String               @id @default(cuid())
  orgId      String
  userId     String
  platform   NotificationPlatform
  token      String               @unique
  browser    String?
  deviceName String?
  active     Boolean              @default(true)
  lastSeenAt DateTime             @default(now())
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  org  Organization @relation(fields: [orgId], references: [id])
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId, active])
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  checkIns            Boolean  @default(true)
  reviews             Boolean  @default(true)
  recognition         Boolean  @default(true)
  goals               Boolean  @default(true)
  linearActivity      Boolean  @default(true)
  systemAnnouncements Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationPlatform {
  WEB
  ANDROID
  IOS
}

enum NotificationType {
  CHECK_IN_CREATED
  CHECK_IN_REMINDER
  GOAL_ASSIGNED
  GOAL_UPDATED
  RECOGNITION_RECEIVED
  REVIEW_REQUESTED
  REVIEW_COMPLETED
  LINEAR_ISSUE_ASSIGNED
  LINEAR_ISSUE_UPDATED
  SYSTEM
}
